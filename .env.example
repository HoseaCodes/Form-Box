# Required: master key for the management API (>= 24 chars)
ADMIN_API_KEY=
PORT=8787
PUBLIC_URL=http://localhost:8787
DATABASE_PATH=./data/formbox.db
# Set to true when running behind a reverse proxy / load balancer
TRUST_PROXY=false
# Optional email notifications, e.g. smtps://user:pass@smtp.resend.com:465
SMTP_URL=
MAIL_FROM=Formbox <no-reply@yourdomain.com>
RATE_LIMIT_PER_MINUTE=10
MAX_BODY_BYTES=100000

# Autoresponse: confirmation email sent back to the submitter.
# Requires a transactional email API that accepts
#   POST {to:[{email}], subject, textContent} with an X-API-Key header.
EMAIL_API_URL=
EMAIL_API_KEY=
# JSON keyed by form id. Forms not listed here send no autoresponse.
# AUTORESPOND={"f_xxxxxxxx":{"subject":"Your download","text":"Here it is: https://..."}}
AUTORESPOND=
